# Copy to .env. Never commit real values.

NODE_ENV=development

# PostgreSQL. DATABASE_URL is used by Prisma migrate/seed (owner/migration role).
# Never point this at production from a developer laptop or Jest.
DATABASE_URL=postgresql://ncr:ncr@localhost:5432/ncr_homes?schema=public

# Isolated Jest HTTP/integration database. Never point this at ncr_homes.
TEST_DATABASE_URL=postgresql://ncr:ncr@localhost:5432/ncr_homes_test?schema=public

# Runtime API connection. Required in staging and production (least-privilege app role).
# Local development and tests use DATABASE_URL and ignore this value.
APP_DATABASE_URL=postgresql://app:app@localhost:5432/ncr_homes?schema=public

JWT_ACCESS_SECRET=change-me-access-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars-long

PUBLIC_APP_URL=http://localhost:3000

# Cookie Secure. Required in staging and production: true for HTTPS, false for HTTP.
# Development and test default to false when unset.
COOKIE_SECURE=false

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=ncr-media
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio-secret
S3_PUBLIC_BASE_URL=http://localhost:9000/ncr-media

MAIL_FROM=noreply@localhost
OPS_INBOX_EMAIL=ops@localhost

# SMTP. Leave SMTP_HOST empty to log emails instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

SENTRY_DSN=
# In-memory per-process limiter for POST /leads, /auth/login, /auth/register, /auth/forgot-password.
RATE_LIMIT_ENABLED=true

# Dev/staging seed only. Never hard-code a production password.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeAdmin1
BOOTSTRAP_ADMIN_PHONE=+919999999999
BOOTSTRAP_ADMIN_NAME=Bootstrap Admin

API_PORT=3001
